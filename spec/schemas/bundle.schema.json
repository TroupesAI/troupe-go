{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.troupes.ai/schema/0.14/bundle.schema.json",
  "title": "Troupe bundle",
  "description": "A Troupe bundle: characters, worlds and scenarios, with publishing metadata stated once.",
  "type": "object",
  "required": [
    "troupe",
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "troupe": {
      "$ref": "#/$defs/version"
    },
    "kind": {
      "const": "bundle"
    },
    "id": {
      "$ref": "#/$defs/opaqueId"
    },
    "name": {
      "$ref": "#/$defs/nonEmpty"
    },
    "tagline": {
      "$ref": "#/$defs/nonEmpty"
    },
    "version": {
      "$ref": "#/$defs/nonEmpty"
    },
    "authors": {
      "$ref": "#/$defs/list"
    },
    "credits": {
      "$ref": "#/$defs/nonEmpty"
    },
    "language": {
      "description": "A BCP 47 language tag (Format 2.5).",
      "type": "string",
      "pattern": "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "tags": {
      "$ref": "#/$defs/list"
    },
    "rating": {
      "enum": [
        "general",
        "mature",
        "explicit"
      ]
    },
    "warnings": {
      "description": "Content warnings; [] for none.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "cover": {
      "$ref": "#/$defs/image"
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      },
      "minItems": 1
    },
    "worlds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/world"
      },
      "minItems": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 1
    },
    "ext": {
      "$ref": "#/$defs/ext"
    }
  },
  "$defs": {
    "version": {
      "description": "Spec version as major.minor, compared as two integers.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "id": {
      "description": "An author ID. CEL reserved words are not allowed.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "not": {
        "enum": [
          "as",
          "break",
          "const",
          "continue",
          "else",
          "false",
          "for",
          "function",
          "if",
          "import",
          "in",
          "let",
          "loop",
          "namespace",
          "null",
          "package",
          "return",
          "true",
          "var",
          "void",
          "while"
        ]
      }
    },
    "ownerId": {
      "description": "A character, world or scenario ID.",
      "allOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "not": {
            "enum": [
              "char",
              "user",
              "narrator",
              "session",
              "state",
              "scene",
              "players",
              "own"
            ]
          }
        }
      ]
    },
    "characterId": {
      "$ref": "#/$defs/ownerId"
    },
    "variableId": {
      "allOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "not": {
            "enum": [
              "scene",
              "own"
            ]
          }
        }
      ]
    },
    "opaqueId": {
      "description": "A message or bundle ID.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "entryRef": {
      "description": "<owner>/<entryId>, where the owner is a character, world or scenario ID, or session.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}/[a-z][a-z0-9_]{0,63}$"
    },
    "stateKey": {
      "description": "A full name: state. and a scenario variable's ID, or an owner and a variable ID, optionally followed by a key; or scene.location / scene.present.",
      "type": "string",
      "pattern": "^(state(\\.[a-z][a-z0-9_]{0,63}){1,3}|scene\\.location|scene\\.present)$"
    },
    "stateValues": {
      "description": "State keys with absolute values, validated against their declarations.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/stateKey"
      },
      "additionalProperties": {
        "not": {
          "type": "null"
        }
      },
      "minProperties": 1
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://\\S+$",
      "format": "uri"
    },
    "cel": {
      "type": "string",
      "minLength": 1
    },
    "packagePath": {
      "description": "A relative path inside a package (Format 12.3).",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "image": {
      "description": "A package path, an https URL, or a base64 data URI of a raster image.",
      "anyOf": [
        {
          "$ref": "#/$defs/packagePath"
        },
        {
          "$ref": "#/$defs/httpsUrl"
        },
        {
          "type": "string",
          "pattern": "^data:image/(png|jpeg|webp|avif|gif);base64,([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{4})$"
        }
      ]
    },
    "extName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "ext": {
      "description": "Extension data, keyed by extension name.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/extName"
      }
    },
    "character": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/characterId"
        },
        "name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "aliases": {
          "$ref": "#/$defs/list"
        },
        "description": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/nonEmpty"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/line"
            }
          },
          "minItems": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "minItems": 1
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "minItems": 1
        },
        "avatar": {
          "$ref": "#/$defs/image"
        },
        "ext": {
          "$ref": "#/$defs/ext"
        }
      }
    },
    "line": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "anyOf": [
            {
              "$ref": "#/$defs/characterId"
            },
            {
              "enum": [
                "char",
                "user"
              ]
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "ext": {
          "$ref": "#/$defs/ext"
        }
      }
    },
    "world": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ownerId"
        },
        "name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "description": {
          "$ref": "#/$defs/nonEmpty"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          },
          "minItems": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "minItems": 1
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "minItems": 1
        },
        "ext": {
          "$ref": "#/$defs/ext"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "description": {
          "$ref": "#/$defs/nonEmpty"
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "ext": {
          "$ref": "#/$defs/ext"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/nonEmpty"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "when": {
          "$ref": "#/$defs/cel"
        },
        "scanDepth": {
          "type": "integer",
          "minimum": 0,
          "default": 4,
          "maximum": 100
        },
        "once": {
          "type": "boolean"
        },
        "sticky": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cooldown": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 100
        },
        "group": {
          "$ref": "#/$defs/id"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        },
        "position": {
          "enum": [
            "system",
            "context"
          ],
          "description": "Absent: context, unless the entry has depth."
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knownBy": {
          "$ref": "#/$defs/knownBy"
        },
        "disabled": {
          "type": "boolean"
        },
        "ext": {
          "$ref": "#/$defs/ext"
        },
        "pull": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "pull"
            ],
            "properties": {
              "pull": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "title"
            ]
          }
        },
        {
          "description": "An entry placed by depth has no position.",
          "not": {
            "required": [
              "position",
              "depth"
            ]
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ownerId"
        },
        "name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "tagline": {
          "$ref": "#/$defs/nonEmpty"
        },
        "premise": {
          "$ref": "#/$defs/nonEmpty"
        },
        "briefing": {
          "$ref": "#/$defs/nonEmpty"
        },
        "mode": {
          "enum": [
            "characters",
            "narrator"
          ],
          "default": "characters"
        },
        "narrator": {
          "$ref": "#/$defs/nonEmpty",
          "default": "the narrator"
        },
        "cast": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/castMember"
          },
          "minItems": 1
        },
        "worlds": {
          "description": "World IDs; [] for none.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownerId"
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opening"
          },
          "minItems": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "minItems": 1
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "minItems": 1
        },
        "ext": {
          "$ref": "#/$defs/ext"
        }
      }
    },
    "castMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character": {
          "$ref": "#/$defs/characterId"
        },
        "notes": {
          "$ref": "#/$defs/nonEmpty"
        },
        "ext": {
          "$ref": "#/$defs/ext"
        },
        "player": {
          "type": "boolean"
        },
        "spoiler": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "player"
            ],
            "properties": {
              "player": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "character"
            ]
          }
        }
      ]
    },
    "opening": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonEmpty"
        },
        "set": {
          "$ref": "#/$defs/stateValues"
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "ext": {
          "$ref": "#/$defs/ext"
        }
      }
    },
    "variable": {
      "type": "object",
      "required": [
        "id",
        "type",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/variableId"
        },
        "type": {
          "enum": [
            "bool",
            "int",
            "string",
            "enum",
            "set"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonEmpty"
          },
          "minProperties": 1
        },
        "min": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "initial": {
          "description": "Validity is checked against the declaration (INVALID_VALUE).",
          "not": {
            "type": "null"
          },
          "if": {
            "type": "object"
          },
          "then": {
            "additionalProperties": {
              "not": {
                "type": "null"
              }
            },
            "minProperties": 1
          }
        },
        "of": {
          "anyOf": [
            {
              "enum": [
                "cast",
                "*"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/keyId"
              }
            }
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmpty"
        },
        "by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "player",
              "model"
            ]
          },
          "minItems": 1
        },
        "maxStep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "oneWay": {
          "type": "boolean"
        },
        "ext": {
          "$ref": "#/$defs/ext"
        },
        "spoiler": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "int",
                  "string",
                  "bool"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "values": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "int",
                  "string"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "labels": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "int"
              }
            }
          },
          "else": {
            "properties": {
              "min": false,
              "max": false,
              "maxStep": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "oneWay": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "of"
            ],
            "properties": {
              "of": {
                "const": "*"
              }
            }
          },
          "then": {
            "properties": {
              "initial": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bool"
              }
            }
          },
          "then": {
            "properties": {
              "labels": {
                "propertyNames": {
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "part": {
      "description": "A text part, or an image part with type image (Format 11).",
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "image"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "src"
        ],
        "additionalProperties": false,
        "properties": {
          "type": true,
          "src": {
            "$ref": "#/$defs/image"
          },
          "alt": {
            "$ref": "#/$defs/nonEmpty"
          },
          "speaker": {
            "$ref": "#/$defs/characterId"
          },
          "ext": {
            "$ref": "#/$defs/ext"
          },
          "knownBy": {
            "$ref": "#/$defs/knownBy"
          }
        }
      },
      "else": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "text"
          },
          "text": {
            "type": "string"
          },
          "speaker": {
            "$ref": "#/$defs/characterId"
          },
          "knownBy": {
            "$ref": "#/$defs/knownBy"
          },
          "ext": {
            "$ref": "#/$defs/ext"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lines": {
          "$ref": "#/$defs/list"
        },
        "veils": {
          "$ref": "#/$defs/list"
        },
        "ext": {
          "$ref": "#/$defs/ext"
        }
      },
      "minProperties": 1
    },
    "list": {
      "description": "A non-empty list of strings.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "knownBy": {
      "description": "Character IDs, or narrator; non-empty.",
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/characterId"
          },
          {
            "const": "narrator"
          }
        ]
      }
    },
    "keyId": {
      "description": "A variable key: an author ID other than char and user.",
      "allOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "not": {
            "enum": [
              "char",
              "user"
            ]
          }
        }
      ]
    }
  }
}
