{
  "description": "Size limits (Format 14, 15.3): a CEL expression of exactly 4 KiB is within the limits, and one byte more is PARSE. The value limits make a value invalid (INVALID_VALUE) and other limits make a file PARSE, so a string state value over 4 KiB or a set of more than 256 members is no PARSE; nor is a long regex key, whose limit makes it a REGEX_ERROR",
  "bundle": {
    "kind": "bundle",
    "scenarios": [
      {
        "id": "s",
        "entries": [
          {
            "id": "long_when",
            "when": "'' != ''",
            "text": "A condition of exactly 4 KiB."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "parse",
      "name": "within the limits",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.14\",\"kind\":\"bundle\",\"scenarios\":[{\"id\":\"s\",\"entries\":[{\"id\":\"long_when\",\"when\":\"'' != ''\",\"text\":\"A condition of exactly 4 KiB.\"}]}]}",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "check",
      "name": "the expression type-checks",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a CEL expression of 4097 bytes",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.14\",\"kind\":\"bundle\",\"scenarios\":[{\"id\":\"s\",\"entries\":[{\"id\":\"long_when\",\"when\":\"'' != ''\",\"text\":\"One byte too long.\"}]}]}",
      "expect": {
        "codes": [
          "PARSE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a string state value of 4097 bytes",
      "note": "INVALID_VALUE, which check tests cover (checks/bundle.json).",
      "kind": "bundle",
      "text": "{\"troupe\":\"0.14\",\"kind\":\"bundle\",\"scenarios\":[{\"id\":\"s\",\"variables\":[{\"id\":\"note\",\"type\":\"string\",\"description\":\"d\"}],\"openings\":[{\"id\":\"o\",\"set\":{\"state.note\":\"\"}}]}]}",
      "expect": {
        "codes": []
      }
    },
