{
  "description": "Packages (Format 12.3, 15.2, 15.3): story.json at the root, sessions anywhere under sessions/, subfolders included, which a story reader may leave unread, and a story.json or session of another version makes the package UNSUPPORTED_VERSION, without this version's checks of what it references; absolute paths, .. segments, backslashes, names equal when compared case-insensitively, encryption, symbolic links and data that fails its CRC-32 are UNREADABLE, and an entry that breaks Format 12.3 is no document, so its version isn't judged, though the other documents' versions still are; a directory entry (a name ending in /) and an unreferenced file outside the path grammar aren't part of the package",
  "tests": [
    {
      "type": "parse",
      "name": "a package",
      "kind": "package",
      "base64": "UEsDBBQAAAAIAAAAS12QkNGAIgAAACAAAAAKAAAAc3RvcnkuanNvbqtWKinKLy1IVbJSMtAzNFXSUcrOzEtRslIqLskvqlSqBQBQSwECFAMUAAAACAAAAEtdkJDRgCIAAAAgAAAACgAAAAAAAAAAAAAAgIEAAAAAc3RvcnkuanNvblBLBQYAAAAAAQABADgAAABKAAAAAAA=",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a package with a session",
      "note": "A story reader accepts it too, and may leave the session unread (Format 15.2).",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a session in a subfolder of sessions/",
      "note": "The session has an unreadable line, so it is UNREADABLE only because it is a session of the package.",
      "level": "session",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a story.json of another version",
      "note": "Its cover names no file of the package, which only this version's rules judge.",
      "kind": "package",
      "base64": "UEsDBBQAAAAIACgJYl3TRo7rMgAAADUAAAAKAAAAc3RvcnkuanNvbqtWKinKLy1IVbJSMtAzNFPSUcrOzEtRslIqLskvqlTSUUrOL0stUrKC0HrlqUkFSrUAUEsBAhQDFAAAAAgAKAliXdNGjusyAAAANQAAAAoAAAAAAAAAAAAAAIABAAAAAHN0b3J5Lmpzb25QSwUGAAAAAAEAAQA4AAAAWgAAAAAA",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a session of another version",
      "note": "The package is UNSUPPORTED_VERSION as a whole (Format 15.3).",
      "level": "session",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a directory entry isn't part of the package",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "no story.json",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a .. segment",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an absolute path",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a backslash",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unreferenced entry outside the path grammar isn't part of the package",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "names that differ only in case",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      },
      "note": "Both are 0.16 stories, but neither entry is a document, so the package is UNREADABLE only."
    },
    {
      "type": "parse",
      "name": "an encrypted entry",
      "kind": "package",
      "base64": "UEsDBBQAAQAIAAAAIQDyTVdqIgAAACAAAAAKAAAAc3RvcnkuanNvbqtWKinKLy1IVbJSMtAzNFPSUcrOzEtRslIqLskvqlSqBQBQSwECFAMUAAEACAAAACEA8k1XaiIAAAAgAAAACgAAAAAAAAAAAAAAgIEAAAAAc3RvcnkuanNvblBLBQYAAAAAAQABADgAAABKAAAAAAA=",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      },
      "note": "The entry's data is a plain 0.16 story, but an encrypted entry is no document, so the package is UNREADABLE only."
    },
    {
      "type": "parse",
      "name": "an entry whose data fails its CRC-32, before a story.json of another version",
      "note": "notes.txt is stored, and its data no longer matches its recorded CRC-32, though nothing references it. The package is UNREADABLE for it, and still UNSUPPORTED_VERSION for story.json, a document stored after it.",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE",
          "UNSUPPORTED_VERSION"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unreferenced symbolic link",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a symbolic link named story.json",
      "kind": "package",
      "base64": "UEsDBBQAAAAIAAAAIQDyTVdqIgAAACAAAAAKAAAAc3RvcnkuanNvbqtWKinKLy1IVbJSMtAzNFPSUcrOzEtRslIqLskvqlSqBQBQSwECFAMUAAAACAAAACEA8k1XaiIAAAAgAAAACgAAAAAAAAAAAAAA/6EAAAAAc3RvcnkuanNvblBLBQYAAAAAAQABADgAAABKAAAAAAA=",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      },
      "note": "story.json is a symbolic link whose target reads as a 0.16 story; an entry that breaks Format 12.3 is no document, so the package is UNREADABLE only."
    },
    {
      "type": "parse",
      "name": "not a ZIP archive",
      "kind": "package",
      "base64": "UEsDBCBub3QgcmVhbGx5",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    }
  ]
}
