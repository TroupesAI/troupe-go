{
  "description": "Package contents and paths (Format 12.2, 12.3, 15.3): package paths appear only in a package, a data: URI's media type is lowercase, and every path a package's story or sessions reference is a file of the package, or it is UNREADABLE; an exact duplicate name and compression methods other than store and deflate are UNREADABLE, and neither entry of a duplicate name is a document; a file with a path segment over 255 bytes isn't part of the package; sessions belong to the package only in their folder",
  "tests": [
    {
      "type": "parse",
      "name": "two entries with the same name",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      },
      "note": "Both are 0.16 stories, so reading either one, first or last, would add UNSUPPORTED_VERSION; neither entry is a document."
    },
    {
      "type": "parse",
      "name": "a compression method other than store or deflate",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a referenced file with a path segment over 255 bytes",
      "note": "The 256-byte name is outside the path grammar, so the file isn't part of the package, and the cover names no file of it.",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "files outside sessions/ or without the session extension aren't sessions of the package",
      "note": "The stray files aren't valid JSON, so they would be UNREADABLE if they were sessions.",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a referenced file the package holds",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a referenced file the package lacks",
      "kind": "package",
      "base64": "UEsDBBQAAAAIAAAAS13rtL/8OAAAADoAAAAKAAAAc3RvcnkuanNvbqtWKinKLy1IVbJSMtAzNFXSUcrOzEtRslIqLskvqlTSUUrOL0stUrJSyk1NyUzUB/P0CvLSlWoBUEsBAhQDFAAAAAgAAABLXeu0v/w4AAAAOgAAAAoAAAAAAAAAAAAAAICBAAAAAHN0b3J5Lmpzb25QSwUGAAAAAAEAAQA4AAAAYAAAAAAA",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a file a session references, which the package lacks",
      "level": "session",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a file a session references, in the package",
      "kind": "package",
      "base64": "",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a package path in a story file",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"story\",\"cover\":\"cover.webp\"}",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an https URL in a story file",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"story\",\"cover\":\"https://example.com/cover.webp\"}",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "an https value that isn't a URL",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"story\",\"cover\":\"https://%%%\"}",
      "expect": {
        "codes": [
          "SCHEMA"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a data: URI in a story file",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"story\",\"cover\":\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNgYGBgAAAABQABpfZFQAAAAABJRU5ErkJggg==\"}",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "a data: URI with an uppercase media type",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"story\",\"cover\":\"data:image/PNG;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNgYGBgAAAABQABpfZFQAAAAABJRU5ErkJggg==\"}",
      "expect": {
        "codes": [
          "SCHEMA"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a package path in a session file",
      "kind": "session",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"session\",\"scenario\":\"s\"}\n{\"id\":\"1\",\"from\":\"player\",\"content\":[{\"type\":\"image\",\"src\":\"map.png\"}]}\n",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    }
  ]
}
