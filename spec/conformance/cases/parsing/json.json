{
  "description": "A story (Format 2.2, 12.1, 15.3): the input must be I-JSON and a Troupe document of the expected kind, or it is UNREADABLE; a missing kind is UNREADABLE alone, not also SCHEMA. An escaped surrogate pair is one character. A story nested 64 deep is within the limits, and one nested 65 deep is UNREADABLE (Format 14)",
  "tests": [
    {
      "type": "parse",
      "name": "the smallest story",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"story\"}",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "not JSON",
      "kind": "story",
      "text": "{\"troupe\":",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "invalid UTF-8",
      "kind": "story",
      "base64": "eyJ0cm91cGUiOiIwLjE1Iiwia2luZCI6InN0b3J5IiwidGFncyI6WyL/Il19",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an escaped surrogate pair is a character",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"story\",\"tags\":[\"\\ud83d\\ude00\"]}",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "depth 64",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"story\",\"ext\":{\"a.b\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}}",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "parse",
      "name": "depth 65",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"story\",\"ext\":{\"a.b\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}}",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a JSON array isn't a Troupe document",
      "kind": "story",
      "text": "[]",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "an unknown kind",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"deck\"}",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a session header where a story is expected",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\",\"kind\":\"session\",\"scenario\":\"s\"}",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a missing kind",
      "kind": "story",
      "text": "{\"troupe\":\"0.15\"}",
      "expect": {
        "codes": [
          "UNREADABLE"
        ]
      }
    },
    {
      "type": "parse",
      "name": "a missing version fails the schema",
      "kind": "story",
      "text": "{\"kind\":\"story\"}",
      "expect": {
        "codes": [
          "SCHEMA"
        ]
      }
    }
  ]
}
