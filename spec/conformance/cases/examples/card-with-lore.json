{
  "description": "Format Appendix B.1: valid; each opening played starts a root, and 'Shore leave' has no content, so its root is a records-only system message; neither opening has set, so neither root records a change (Format 6.3, 11.1, 11.4)",
  "bundleFile": "../../../examples/mira-card.troupe.json",
  "session": {
    "header": {
      "kind": "session",
      "scenario": "kestrel",
      "characters": [
        {
          "id": "you",
          "name": "You",
          "description": "The player."
        }
      ],
      "players": [
        "you"
      ]
    },
    "messages": [
      {
        "id": "1",
        "opening": "docked",
        "from": "system",
        "content": [
          {
            "speaker": "mira",
            "text": "*She doesn't look up from the reactor.* If you're here about the noise, it's supposed to sound like that."
          }
        ]
      },
      {
        "id": "4",
        "opening": "shore_leave",
        "from": "system",
        "content": []
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "state",
      "name": "the whole cast is present from the start",
      "at": "1",
      "expect": {
        "scene.present": [
          "you",
          "mira"
        ],
        "scene.location": ""
      }
    },
    {
      "type": "state",
      "at": "4",
      "expect": {
        "scene.present": [
          "you",
          "mira"
        ]
      }
    },
    {
      "type": "cel",
      "name": "the shore entry's condition holds at the records-only root",
      "at": "4",
      "expr": "opening == 'shore_leave' && turn == 0",
      "expect": true
    },
    {
      "type": "cel",
      "at": "1",
      "expr": "opening == 'shore_leave'",
      "expect": false
    }
  ]
}
