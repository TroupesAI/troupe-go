  "tests": [
    {
      "type": "cel",
      "name": "a key matches before an apostrophe",
      "at": "r1",
      "expr": "hit('Kai')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "case is ignored",
      "at": "r1",
      "expr": "hit('kai') && hit('BOAT')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "a key never matches part of a word",
      "at": "r1",
      "expr": "hit('boa')",
      "expect": false
    },
    {
      "type": "cel",
      "name": "the speaker's name is scanned",
      "at": "r1",
      "expr": "hit('Pat')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "a longer word doesn't match",
      "at": "r2",
      "expr": "hit('Kai')",
      "expect": false
    },
    {
      "type": "cel",
      "name": "an underscore isn't a letter, mark or number, so the word ends there",
      "at": "r3",
      "expr": "hit('kai')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "a combining mark continues the word",
      "at": "r4",
      "expr": "hit('cafe')",
      "expect": false
    },
    {
      "type": "cel",
      "name": "a key in Han or Hiragana matches anywhere",
      "at": "r5",
      "expr": "hit('女王')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "simple case folding folds final sigma and accented capitals",
      "at": "r6",
      "expr": "hit('σίσυφος')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "simple case folding doesn't turn ß into ss",
      "at": "r7",
      "expr": "hit('straße')",
      "expect": false
    },
    {
      "type": "cel",
      "name": "simple case folding leaves a capital dotted I alone",
      "at": "r8",
      "expr": "hit('istanbul')",
      "expect": false
    },
    {
      "type": "cel",
      "name": "a regex key matches anywhere",
      "at": "r9",
      "expr": "hit('/ragon/')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "and case-sensitively without i",
      "at": "r9",
      "expr": "hit('/dragons?/')",
      "expect": false
    },
    {
      "type": "cel",
      "name": "the flag i ignores case",
      "at": "r9",
      "expr": "hit('/dragons?/i')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "under m, ^ matches after CRLF",
      "at": "r13",
      "expr": "hit('/^b/m')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "and after U+2028, written as \\n",
      "at": "r14",
      "expr": "hit('/^b/m')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "CRLF is one character, so . with s spans it",
      "at": "r13",
      "expr": "hit('/a.b/s')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "the empty key never matches",
      "at": "r9",
      "expr": "hit('')",
      "expect": false
    },
    {
      "type": "cel",
      "name": "a part is scanned for whoever knows it",
      "at": "r10",
      "expr": "hit('vault')",
      "expect": true,
      "char": "a"
    },
    {
      "type": "cel",
      "name": "a part isn't scanned for whoever doesn't",
      "at": "r10",
      "expr": "hit('vault')",
      "expect": false,
      "char": "b"
    },
    {
      "type": "cel",
      "name": "nor for the narrator, whom its knownBy leaves out",
      "at": "r10",
      "expr": "hit('vault')",
      "expect": false
    },
    {
      "type": "cel",
      "name": "hidden messages aren't scanned",
      "at": "r11",
      "expr": "hit('rope')",
      "expect": false
    },
    {
      "type": "cel",
      "name": "four messages are scanned by default",
      "at": "c2",
      "expr": "hit('lantern')",
      "expect": true
    },
    {
      "type": "cel",
      "name": "scanDepth limits the messages scanned",
      "at": "c2",
      "expr": "hit('lantern')",
      "expect": false,
      "scanDepth": 2
    },
    {
      "type": "cel",
      "name": "hidden messages don't count toward scanDepth",
      "at": "h3",
      "expr": "hit('beacon')",
      "scanDepth": 2,
      "expect": true
    },
    {
      "type": "cel",
      "name": "without at nothing is scanned",
      "expr": "hit('Kai')",
      "expect": false
    },
    {
      "type": "check",
      "expect": {
        "codes": []
      }
    }
  ]
}
