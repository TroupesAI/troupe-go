{
  "description": "In every text where macros resolve, such as a briefing, cast notes, a variable's description and an image's alt, a {{ whose text up to the next }} holds no macro, such as {{original}}, and a macro naming an undeclared variable are UNKNOWN_MACRO (Format 9, 15.3); a pick needs at least two options, none empty. Names, taglines and titles are used as written, so they hold no UNKNOWN_MACRO",
  "bundle": {
    "kind": "bundle",
    "tagline": "Into the {{dark}}.",
    "scenarios": [
      {
        "id": "s",
        "name": "The {{dark}}",
        "tagline": "{{nothing}} waits.",
        "briefing": "Bring {{a_lamp}}.",
        "cast": [
          {
            "notes": "{{nobody}} sits here."
          }
        ],
        "entries": [
          {
            "id": "e",
            "text": "{{char}} sees {{state.nothing_here}}."
          },
          {
            "id": "one",
            "text": "Either {{pick::a}}."
          },
          {
            "id": "empty",
            "text": "Or {{pick::a::}}."
          },
          {
            "id": "fine",
            "title": "{{not_a_macro}}",
            "text": "{{pick::a::b}} and {{pick::x::x}}."
          },
          {
            "id": "at",
            "text": "{{original}} waves."
          }
        ],
        "openings": [
          {
            "id": "o",
            "content": [
              {
                "type": "image",
                "src": "https://example.com/door.webp",
                "alt": "A door to {{nowhere}}."
              }
            ]
          }
        ],
        "variables": [
          {
            "id": "v",
            "type": "int",
            "description": "How {{nowhere}} feels."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
        "codes": [
          "UNKNOWN_MACRO"
        ],
        "includes": [
          {
            "code": "UNKNOWN_MACRO",
            "at": "/scenarios/0/entries/0/text"
          },
          {
            "code": "UNKNOWN_MACRO",
            "at": "/scenarios/0/entries/1/text"
          },
          {
            "code": "UNKNOWN_MACRO",
            "at": "/scenarios/0/entries/2/text"
          },
          {
            "code": "UNKNOWN_MACRO",
            "at": "/scenarios/0/entries/4/text"
          },
          {
            "code": "UNKNOWN_MACRO",
            "at": "/scenarios/0/briefing"
          },
          {
            "code": "UNKNOWN_MACRO",
            "at": "/scenarios/0/cast/0/notes"
          },
          {
            "code": "UNKNOWN_MACRO",
            "at": "/scenarios/0/openings/0/content/0/alt"
          },
          {
            "code": "UNKNOWN_MACRO",
            "at": "/scenarios/0/variables/0/description"
          }
        ]
      }
    }
  ]
}
