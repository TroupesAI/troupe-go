{
  "description": "Credits and spoilers (Format 3, 6.1): bundle credits and a spoiler cast member are valid, and a spoiler cast member is an ordinary cast member in the state, offstage while the opening's set leaves it out of scene.present and present once a change adds it (Format 8.6)",
  "bundle": {
    "kind": "bundle",
    "name": "The Cellar",
    "authors": [
      "Sakura"
    ],
    "credits": "Based on [The Cellar](https://example.com/cellar) by Sakura. CC BY 4.0.",
    "characters": [
      {
        "id": "ann",
        "name": "Ann",
        "description": "A guide."
      },
      {
        "id": "ghost",
        "name": "The Ghost",
        "description": "A ghost in the cellar."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "ann"
          },
          {
            "character": "ghost",
            "spoiler": true,
            "notes": "A spoiler until first present on the path."
          }
        ],
        "openings": [
          {
            "id": "o",
            "set": {
              "scene.present": [
                "ann"
              ]
            },
            "content": [
              {
                "speaker": "ann",
                "text": "Mind the stairs."
              }
            ]
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "opening": "o",
        "from": "system",
        "content": [
          {
            "speaker": "ann",
            "text": "Mind the stairs."
          }
        ],
        "changes": [
          {
            "by": "opening",
            "set": {
              "scene.present": [
                "ann",
                "p"
              ]
            }
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "What was that noise?"
          }
        ]
      },
      {
        "id": "3",
        "parent": "2",
        "from": "model",
        "char": "ann",
        "content": [
          {
            "speaker": "ann",
            "text": "The ghost drifts out of the wall."
          }
        ],
        "changes": [
          {
            "by": "model",
            "set": {
              "scene.present": [
                "p",
                "ann",
                "ghost"
              ]
            }
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "name": "credits and spoiler validate",
      "expect": {
        "codes": []
      }
    },
    {
      "type": "state",
      "name": "a spoiler cast member the opening leaves out is offstage",
      "at": "1",
      "expect": {
        "scene.present": [
          "p",
          "ann"
        ]
      }
    },
    {
      "type": "state",
      "name": "a change makes a spoiler cast member present like any other",
      "at": "3",
      "expect": {
        "scene.present": [
          "p",
          "ann",
          "ghost"
        ]
      }
    }
  ]
}
