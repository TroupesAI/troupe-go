{
  "description": "Session entries (Format 6.4, 11.3, 15.3): an entry disabled by a later message is no longer in use, so a message after that can't list it in activated (UNKNOWN_ENTRY); one message can't add two entries with one ID (DUPLICATE_ID)",
  "bundle": {
    "kind": "bundle",
    "characters": [
      {
        "id": "a",
        "name": "Ann",
        "description": "Ann."
      }
    ],
    "scenarios": [
      {
        "id": "s",
        "cast": [
          {},
          {
            "character": "a"
          }
        ]
      }
    ]
  },
  "session": {
    "header": {
      "kind": "session",
      "scenario": "s",
      "characters": [
        {
          "id": "p",
          "name": "Pat",
          "description": "Pat."
        }
      ],
      "players": [
        "p"
      ]
    },
    "messages": [
      {
        "id": "1",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Note this."
          }
        ],
        "entries": [
          {
            "id": "clue",
            "text": "The key is under the mat."
          }
        ]
      },
      {
        "id": "2",
        "parent": "1",
        "from": "model",
        "char": "a",
        "activated": [
          "session/clue"
        ],
        "content": [
          {
            "speaker": "a",
            "text": "Noted."
          }
        ]
      },
      {
        "id": "3",
        "parent": "2",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Forget it."
          }
        ],
        "entries": [
          {
            "id": "clue",
            "text": "Forgotten.",
            "disabled": true
          }
        ]
      },
      {
        "id": "4",
        "parent": "3",
        "from": "model",
        "char": "a",
        "activated": [
          "session/clue"
        ],
        "content": [
          {
            "speaker": "a",
            "text": "Forgotten."
          }
        ]
      },
      {
        "id": "5",
        "parent": "4",
        "from": "player",
        "content": [
          {
            "speaker": "p",
            "text": "Two notes."
          }
        ],
        "entries": [
          {
            "id": "dup",
            "text": "One."
          },
          {
            "id": "dup",
            "text": "Two."
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "type": "check",
      "expect": {
        "codes": [
          "DUPLICATE_ID",
          "UNKNOWN_ENTRY"
        ],
        "includes": [
          {
            "code": "UNKNOWN_ENTRY",
            "at": "message:4/activated/0"
          },
          {
            "code": "DUPLICATE_ID",
            "at": "message:5/entries/1/id"
          }
        ]
      }
    }
  ]
